# 换行符策略：避免「Windows 上用得好好的脚本，别人 clone 下来就坏」
#
#   .cmd / .bat / .ps1 → 检出时必须是 CRLF（cmd.exe 对 LF 结尾的批处理在
#                        if(...) 块与 goto 标签上会出错）
#   .sh                → 必须是 LF（否则 Linux 上报 bad interpreter: /bin/sh^M）
#   其余文本           → 交给 git 自动处理
* text=auto

*.sh    text eol=lf
*.service text eol=lf

*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# 二进制：别做任何换行/编码处理
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text eol=lf
*.db    binary
*.gguf  binary
